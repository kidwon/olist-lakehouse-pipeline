{
  "datasets": [
    {
      "name": "kpi_ops",
      "displayName": "kpi_ops",
      "queryLines": [
        "SELECT COUNT(DISTINCT run_id) AS runs,\n",
        "COUNT(DISTINCT CASE WHEN NOT passed THEN run_id END) AS blocked_runs,\n",
        "(SELECT COUNT(*) FROM workspace.olist_ops.quarantine) AS quarantined\n",
        "FROM workspace.olist_ops.dq_gate_log\n"
      ]
    },
    {
      "name": "dq_ratio",
      "displayName": "dq_ratio",
      "queryLines": [
        "SELECT batch_date, table_name AS series, SUM(failed_rows) / SUM(total_rows) AS bad_ratio\n",
        "FROM workspace.olist_ops.dq_metrics\n",
        "WHERE rule = '__all__'\n",
        "GROUP BY ALL\n",
        "UNION ALL\n",
        "SELECT DISTINCT batch_date, 'threshold (5%)' AS series, 0.05 AS bad_ratio\n",
        "FROM workspace.olist_ops.dq_metrics\n"
      ]
    },
    {
      "name": "dq_errors",
      "displayName": "dq_errors",
      "queryLines": [
        "SELECT batch_date, rule, SUM(failed_rows) AS rows\n",
        "FROM workspace.olist_ops.dq_metrics\n",
        "WHERE severity = 'error' AND rule <> '__all__' AND failed_rows > 0 AND batch_date > DATE'2018-05-31'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "dq_handled",
      "displayName": "dq_handled",
      "queryLines": [
        "SELECT batch_date, rule, SUM(failed_rows) AS rows\n",
        "FROM workspace.olist_ops.dq_metrics\n",
        "WHERE severity IN ('info', 'warn') AND failed_rows > 0 AND batch_date > DATE'2018-05-31'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "dq_gate",
      "displayName": "dq_gate",
      "queryLines": [
        "SELECT evaluated_at, run_id, table_name, bad_rows, total_rows,\n",
        "ROUND(bad_ratio * 100, 2) AS bad_pct, passed\n",
        "FROM workspace.olist_ops.dq_gate_log\n",
        "WHERE total_rows > 0\n",
        "ORDER BY evaluated_at DESC, table_name\n"
      ]
    },
    {
      "name": "dq_quarantine",
      "displayName": "dq_quarantine",
      "queryLines": [
        "SELECT batch_date, table_name, array_join(failed_rules, ', ') AS rules, record\n",
        "FROM workspace.olist_ops.quarantine\n",
        "ORDER BY quarantined_at DESC\n"
      ]
    },
    {
      "name": "ops_incremental",
      "displayName": "ops_incremental",
      "queryLines": [
        "SELECT measured_at, replace(target, 'workspace.olist_gold.', '') AS fact, mode,\n",
        "processed_orders, total_orders,\n",
        "processed_orders / total_orders AS processed_share\n",
        "FROM workspace.olist_ops.gold_incremental_stats\n"
      ]
    },
    {
      "name": "kpi_biz",
      "displayName": "kpi_biz",
      "queryLines": [
        "SELECT ROUND(SUM(CASE WHEN NOT is_cancelled THEN price END) / 1e6, 2) AS gmv_millions,\n",
        "COUNT(DISTINCT order_id) AS orders,\n",
        "AVG(CASE WHEN is_delivered THEN CAST(is_on_time AS INT) END) AS on_time_rate\n",
        "FROM workspace.olist_gold.fact_order_item\n"
      ]
    },
    {
      "name": "biz_monthly",
      "displayName": "biz_monthly",
      "queryLines": [
        "SELECT to_date(d.year_month || '-01') AS month,\n",
        "SUM(CASE WHEN NOT f.is_cancelled THEN f.price END) AS gmv,\n",
        "AVG(CASE WHEN f.is_delivered THEN CAST(f.is_on_time AS INT) END) AS on_time_rate\n",
        "FROM workspace.olist_gold.fact_order_item f\n",
        "JOIN workspace.olist_gold.dim_date d ON d.date_key = f.order_date_key\n",
        "WHERE d.date >= DATE'2017-01-01'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "biz_state",
      "displayName": "biz_state",
      "queryLines": [
        "SELECT s.seller_state,\n",
        "SUM(f.price) AS gmv,\n",
        "AVG(CASE WHEN f.is_delivered THEN CAST(f.is_on_time AS INT) END) AS on_time_rate\n",
        "FROM workspace.olist_gold.fact_order_item f\n",
        "JOIN workspace.olist_gold.dim_seller s ON s.seller_sk = f.seller_sk\n",
        "WHERE NOT f.is_cancelled\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "biz_fulfillment",
      "displayName": "biz_fulfillment",
      "queryLines": [
        "SELECT to_date(date_format(purchase_ts, 'yyyy-MM-01')) AS month, stage, ROUND(AVG(hours), 1) AS avg_hours\n",
        "FROM workspace.olist_gold.fact_order_fulfillment\n",
        "LATERAL VIEW STACK(3,\n",
        "'1 purchase → approved', hours_to_approve,\n",
        "'2 approved → carrier', hours_to_ship,\n",
        "'3 carrier → customer', hours_in_transit) s AS stage, hours\n",
        "WHERE purchase_ts >= TIMESTAMP'2017-01-01' AND hours IS NOT NULL\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "biz_backlog",
      "displayName": "biz_backlog",
      "queryLines": [
        "SELECT snapshot_date, order_status, SUM(open_orders) AS open_orders\n",
        "FROM workspace.olist_gold.fact_daily_order_backlog\n",
        "WHERE snapshot_date >= DATE'2017-01-01'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "biz_lateness_score",
      "displayName": "biz_lateness_score",
      "queryLines": [
        "SELECT CASE\n",
        "WHEN hours_late <= -168 THEN '1. 7+ days early'\n",
        "WHEN hours_late <= 0    THEN '2. 0-7 days early'\n",
        "WHEN hours_late <= 72   THEN '3. 1-3 days late'\n",
        "WHEN hours_late <= 168  THEN '4. 4-7 days late'\n",
        "ELSE '5. 8+ days late'\n",
        "END AS lateness,\n",
        "COUNT(*) AS orders,\n",
        "ROUND(AVG(review_score), 2) AS avg_review_score\n",
        "FROM workspace.olist_gold.fact_order_fulfillment\n",
        "WHERE delivered_ts IS NOT NULL AND review_score IS NOT NULL\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "biz_top",
      "displayName": "biz_top",
      "queryLines": [
        "SELECT seller_id, seller_state,\n",
        "ROUND(SUM(gmv), 0) AS gmv, SUM(orders) AS orders,\n",
        "ROUND(SUM(on_time_orders) / NULLIF(SUM(delivered_orders), 0), 3) AS on_time_rate,\n",
        "ROUND(AVG(avg_review_score), 2) AS avg_review_score\n",
        "FROM workspace.olist_gold.mart_seller_delivery_performance\n",
        "GROUP BY ALL\n",
        "ORDER BY gmv DESC\n",
        "LIMIT 15\n"
      ]
    }
  ],
